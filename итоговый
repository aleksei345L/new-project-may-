import turtle
import math
wn = turtle.Screen()
wn.title("Продвинутая интерактивная геометрическая программа")
wn.setup(width=900, height=700)
drawer = turtle.Turtle()
drawer.speed(0)  # Максимальная скорость для анимации
drawer.hideturtle()
def draw_line(length):
    """Рисует линию длиной length с анимацией."""
    drawer.pendown()
    drawer.forward(length)
    drawer.penup()
def draw_square(side_length):
    """Рисует квадрат, используя функцию draw_line."""
    for _ in range(4):
        draw_line(side_length)
        drawer.right(90)
def draw_regular_polygon(sides, side_length):
    """Рисует правильный многоугольник с расчетом угла."""
    angle = 360 / sides
    for _ in range(sides):
        draw_line(side_length)
        drawer.right(angle)
def draw_circle(radius):
    drawer.circle(radius)
def draw_star(size):
    """Рисует пятиконечную звезду."""
    for _ in range(5):
        draw_line(size)
        drawer.right(144)
def calculate_polygon_side_radius(sides, apothem_length):
    """Вычисляет длину стороны многоугольника по апофеме и количеству сторон."""
    angle = math.pi / sides
    side_length = 2 * math.tan(angle) * apothem_length
    return side_length
def calculate_circle_area(radius):
    return math.pi * radius ** 2
def main_menu():
    while True:
        print("\n--- Выберите действие ---")
        print("1. Нарисовать квадрат")
        print("2. Нарисовать правильный многоугольник")
        print("3. Нарисовать окружность")
        print("4. Нарисовать звезду")
        print("5. Расчет площади окружности")
        print("6. Выйти")
        choice = input("Введите номер: ")
        if choice == '1':
            size = float(input("Введите длину стороны квадрата: "))
            drawer.clear()
            drawer.penup()
            drawer.goto(-size/2, -size/2)  # Центрирование
            drawer.pendown()
            draw_square(size)
        elif choice == '2':
            sides = int(input("Введите число сторон: "))
            apothem = float(input("Введите апофему (расстояние от центра до стороны): "))
            side_length = calculate_polygon_side_radius(sides, apothem)
            drawer.clear()
            drawer.penup()
            drawer.goto(0, -apothem)  # Центрирование
            drawer.setheading(0)
            drawer.pendown()
            draw_regular_polygon(sides, side_length)
        elif choice == '3':
            radius = float(input("Введите радиус окружности: "))
            drawer.clear()
            drawer.penup()
            drawer.goto(0, -radius)
            drawer.setheading(0)
            drawer.pendown()
            draw_circle(radius)
        elif choice == '4':
            size = float(input("Введите размер звезды: "))
            drawer.clear()
            drawer.penup()
            drawer.goto(0, 0)
            drawer.setheading(0)
            drawer.pendown()
            draw_star(size)
        elif choice == '5':
            radius = float(input("Введите радиус окружности для расчета площади: "))
            area = calculate_circle_area(radius)
            print(f"Площадь окружности с радиусом {radius} равна {area:.2f}")
        elif choice == '6':
            print("Выход из программы.")
            break
        else:
            print("Некорректный ввод, попробуйте снова.")

main_menu()

turtle.done()

